# ============ DATABASE (Neon PostgreSQL) ============
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# ============ AI PROVIDERS (free API keys) ============
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Provider selection: groq (primary) | gemini (fallback)
VLM_PROVIDER=groq
VLM_MODEL=qwen/qwen3.8-27b

# ============ STORAGE ============
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10

# ============ LOGGING ============
LOG_LEVEL=INFO

# ============ CONFIDENCE THRESHOLDS ============
CONFIDENCE_AUTO_APPROVE=0.85
CONFIDENCE_REVIEW_THRESHOLD=0.60